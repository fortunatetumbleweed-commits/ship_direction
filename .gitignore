# Python environment & caches
.venv/
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Override the user's global ~/.gitignore_global (which ignores README.md):
# this project keeps its docs in git.
!README.md

# Generated outputs (regenerable by the tools)
out/
match_out/
ship_fragments/
reconstructed/
sample_sheet.png
*.log
report.html

# keypoint previews (regenerable)
*_preview.png

# keypoint diagnostic images (regenerate with keypoint_model/viz.py)
kp_*.png
feature_*.png
parts_*.png

# ...but keep the key region-parts diagnostics that shaped the work:
#   how the parts are defined, how the matching works, and the pre-fix t083 issue
!parts_preview.png
!parts_features.png
!parts_features_pre_t083fix.png
